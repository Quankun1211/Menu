{
  "expo": {
    "name": "Bếp Việt",
    "slug": "bep-viet",
    "version": "1.0.0",
    "extra": {
      "API_BASE_URL": "http://192.168.100.188:8081/api",
      "API_LOCAL": "192.168.100.188:8081",
      "TOKEN_KEY": "token",
      "REFRESH_TOKEN_KEY": "refresh_token",
      "LOCALE_KEY": "locale",
      "THEME_KEY": "theme",
      "apiGetMapKey": "AkqTvBuwzoIlNaku55keEDNlo3nPSlteAc36yRsE",
      "apiMapKey": "ZYA8D0xxBD5Kzfta2Hwq3XwEbSvP7cSCEShrRwoR"
    },
    "orientation": "portrait",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Bếp Việt dùng vị trí của shipper để hiển thị lộ trình, cập nhật vị trí giao hàng và dẫn đường đến khách hàng."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
